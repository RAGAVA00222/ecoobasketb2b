# ---------------------------------------------------------------------------
# Ecoo Basket - environment variables
# Copy to .env.local for development, and set the same keys in your host
# (Vercel / Netlify / etc.) for production. .env* is gitignored.
#
# NOTHING here is prefixed NEXT_PUBLIC_ except the Sentry DSN, which is a
# public value by design. Every other variable is server-only and is never
# sent to the browser.
# ---------------------------------------------------------------------------


# ===========================================================================
# LEAD CAPTURE  --  ACTION REQUIRED BEFORE LAUNCH
# ===========================================================================
# Configure AT LEAST ONE destination below, otherwise POST /api/leads returns
# 503 and the contact form tells the visitor to use WhatsApp instead.
#
# That is deliberate: the form will never show a fake "thank you" for an
# enquiry that went nowhere. Every lead is also written to the server log, so
# even a total delivery failure leaves it recoverable from your host's logs.
# ===========================================================================

# --- Option A: webhook (simplest, free) ------------------------------------
# Any URL that accepts a JSON POST. Works with a Google Apps Script bound to a
# Google Sheet, Zapier, Make, n8n, or your own CRM endpoint.
# Payload: { "source": "ecoobasketb2b.com", "lead": { name, mobile, email,
#            businessName, area, message, receivedAt, sourceIp, userAgent } }
LEAD_WEBHOOK_URL=

# Optional shared secret. When set it is sent as the X-Ecoo-Signature header
# so your receiver can reject anything that is not from this site.
LEAD_WEBHOOK_SECRET=

# --- Option B: email notification via Resend --------------------------------
# All three must be set for email delivery to activate.
# RESEND_API_KEY  -> from https://resend.com (server-only, never exposed)
# LEAD_FROM_EMAIL -> an address on a domain you have verified with Resend
# LEAD_NOTIFY_EMAIL -> where enquiries should land, e.g. info@ecoobasketb2b.com
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=


# ===========================================================================
# ERROR MONITORING (Sentry)  --  optional
# ===========================================================================
# Leave blank and the app still builds and runs, but no error is reported
# anywhere. Without a DSN, Sentry.init() is a no-op, so the site has NO
# production error monitoring.
NEXT_PUBLIC_SENTRY_DSN=

# Required ONLY for uploading source maps at build time. When any of the three
# is missing the upload step is skipped (dryRun) instead of failing the build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional release identifier; falls back to the git SHA on Vercel.
NEXT_PUBLIC_SENTRY_RELEASE=
